# Copia para .env (nunca commitado) e ajusta conforme o modo de execução.

# "local" = dados reais, SQLite local, uso pessoal. "demo" = dados sinteticos, hospedado.
APP_ENV=local

# Local (default): SQLite em arquivo.
DATABASE_URL=sqlite:///./w8t_local.db

# Demo hospedado (Neon Postgres), exemplo:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Opcional: só necessario para a camada de insights (narrativa via IA generativa).
# ANTHROPIC_API_KEY=
